+def _resize_and_initialize_temporal_tokens(model, tokenizer) -> None:
+    """Resize embeddings and initialize new temporal tokens from base-vocabulary statistics.
+
+    Recent Transformers releases implement ``mean_resizing=True`` by sampling
+    added input and output embeddings from a multivariate normal distribution
+    with the old vocabulary's empirical mean and covariance.  The explicit
+    argument documents and preserves the initialization used by TimePLE.
+    """
+    try:
+        model.resize_token_embeddings(len(tokenizer), mean_resizing=True)
+    except TypeError:
+        # Compatibility for older/custom model classes without mean_resizing.
+        old_vocab_size = model.get_input_embeddings().weight.shape[0]
+        model.resize_token_embeddings(len(tokenizer))
+        if len(tokenizer) <= old_vocab_size:
+            return
+
+        with torch.no_grad():
+            input_weight = model.get_input_embeddings().weight
+            reference = input_weight[:old_vocab_size].float()
+            mean = reference.mean(dim=0)
+            std = reference.var(dim=0, unbiased=False).clamp_min(1e-12).sqrt()
+            input_weight[old_vocab_size:].copy_(
+                (mean + torch.randn_like(input_weight[old_vocab_size:].float()) * std).to(input_weight.dtype)
+            )
+
+            output_embeddings = model.get_output_embeddings()
+            if output_embeddings is not None and output_embeddings.weight.data_ptr() != input_weight.data_ptr():
+                output_weight = output_embeddings.weight
+                output_reference = output_weight[:old_vocab_size].float()
+                output_mean = output_reference.mean(dim=0)
+                output_std = output_reference.var(dim=0, unbiased=False).clamp_min(1e-12).sqrt()
+                output_weight[old_vocab_size:].copy_(
+                    (output_mean + torch.randn_like(output_weight[old_vocab_size:].float()) * output_std).to(
+                        output_weight.dtype
+                    )
+                )
+
