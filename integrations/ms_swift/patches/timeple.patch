+    positions = positions.to(device=inputs_embeds.device, dtype=torch.long)
+    timestamp_embeddings = timestamp_embeddings.to(device=inputs_embeds.device, dtype=inputs_embeds.dtype)
+    inputs_embeds[batch_indices, positions, :] = timestamp_embeddings
+    return inputs_embeds
