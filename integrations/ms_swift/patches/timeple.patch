+    freeze_language = kwargs.get("freeze_language", False)
+    use_time_codec_projection = kwargs.get("use_time_codec_projection", False)
+    time_codec_projection_type = kwargs.get("time_codec_projection_type", "linear")
+    time_codec_projection_hidden_dim = kwargs.get("time_codec_projection_hidden_dim", None)
