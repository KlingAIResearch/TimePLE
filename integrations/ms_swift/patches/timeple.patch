+
+    timestamp_token_id, timespan_token_id = _ensure_special_time_tokens(tokenizer)
+
+    processor = Qwen3VLProcessorWithTimeCodec(
+        image_processor=getattr(base_processor, "image_processor", None),
+        tokenizer=tokenizer,
+        video_processor=getattr(base_processor, "video_processor", None),
+        chat_template=getattr(base_processor, "chat_template", None),
+        use_time_codec=True,
