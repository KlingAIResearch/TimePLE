+        time_codec_projection_identity_init=time_codec_projection_identity_init,
+        time_codec_projection_bias=time_codec_projection_bias,
+    )
+    config.timestamp_token_id = timestamp_token_id
+    config.timespan_token_id = timespan_token_id
+
+    kwargs['tokenizer'] = tokenizer
+    kwargs['model_config'] = config
+    kwargs['automodel_class'] = kwargs['automodel_class'] or Qwen3VLForConditionalGenerationWithTimeCodec
+    kwargs['_check_qwen_vl_utils'] = False
+
+    model, _ = get_model_tokenizer_with_flash_attn(model_dir, model_info, model_kwargs, load_model, **kwargs)
