+            image = Image.open(BytesIO(frame["bytes"]))
+            image.load()
+            if image.mode != "RGB":
+                image = image.convert("RGB")
+            return image
+        if "path" in frame and frame["path"]:
+            image = Image.open(frame["path"])
+            image.load()
+            if image.mode != "RGB":
+                image = image.convert("RGB")
+            return image
