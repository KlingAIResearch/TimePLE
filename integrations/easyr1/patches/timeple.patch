+        output = self.actor_module(
+            input_ids=input_ids,
+            attention_mask=attention_mask,
+            position_ids=position_ids,
+            **multi_modal_inputs,
+            **time_codec_kwargs,
+            use_cache=False,
+            output_hidden_states=False,
+            return_dict=True,
