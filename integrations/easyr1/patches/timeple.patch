+def _spod_reward_from_uv(
+    *,
+    codec: nn.Module,
+    features: torch.Tensor,
+    uv: torch.Tensor,
+    micro_batch: dict[str, Any],
+    durations: torch.Tensor,
+    reward_type: str,
