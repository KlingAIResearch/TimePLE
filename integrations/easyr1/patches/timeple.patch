+def _zero_metrics(tau_candidates: Sequence[float]) -> dict[str, float]:
+    metrics = {
+        "tr_spd_loss": 0.0,
+        "tr_spd_span_ce": 0.0,
+        "tr_spd_reject_retention_loss": 0.0,
+        "tr_spd_accept_rate": 0.0,
+        "tr_spd_valid_frac": 0.0,
+        "tr_spd_reward_prior": 0.0,
