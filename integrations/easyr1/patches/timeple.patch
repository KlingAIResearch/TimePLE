+                "timecodec"
+                if is_timecodec_model
+                else (
+                    "timeple"
+                    if is_timeple_model or is_timeple_model
+                    else ("timeed" if is_timeed_model else "cis")
+                )
+            ),
+        )
+        if best_decoded_prediction is not None:
+            for key, value in best_decoded_prediction.items():
